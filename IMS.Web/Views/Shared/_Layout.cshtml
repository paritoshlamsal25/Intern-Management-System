<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IMS.Web</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/IMS.Web.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var isAuthenticated = User?.Identity?.IsAuthenticated ?? false;
        var isAdmin = User?.IsInRole("Admin") ?? false;
        var isHr = User?.IsInRole("HR") ?? false;
        var isMentor = User?.IsInRole("Mentor") ?? false;
        var isIntern = User?.IsInRole("Intern") ?? false;
        var hideSidebar = (bool)(ViewBag.HideSidebar ?? false);
        var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    }

    <!-- Top Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom border-secondary sticky-top shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand d-flex align-items-center fw-bold text-primary" asp-controller="@(isAuthenticated ? "Dashboard" : "Account")" asp-action="@(isAuthenticated ? "Index" : "Login")">
                <i class="bi bi-mortarboard-fill me-2"></i>IMS Portal
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#topNav" aria-controls="topNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="topNav">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-center">
                    @if (isAuthenticated)
                    {
                        <li class="nav-item me-3">
                            <span class="navbar-text text-light">
                                <i class="bi bi-person-circle me-1"></i> Hello, <strong>@(User?.Identity?.Name ?? "User")</strong>
                            </span>
                        </li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-box-arrow-right me-1"></i> Logout
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Login
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container-fluid p-0">
        <div class="d-flex w-100">

            <!-- Sidebar Navigation -->
            @if (!hideSidebar)
            {
                <aside class="sidebar bg-dark text-white p-3 border-end border-secondary">
                    <button class="btn btn-sm btn-outline-light d-md-none mb-3 w-100" id="sidebarToggle">
                        <i class="bi bi-list me-1"></i> Toggle Menu
                    </button>

                    <ul class="nav flex-column nav-pills">
                        @if (isAuthenticated)
                        {
                            <li class="nav-item mb-2">
                                <a asp-controller="Dashboard" asp-action="Index"
                                   class="nav-link text-white @(currentController == "Dashboard" ? "active bg-primary" : "")">
                                    <i class="bi bi-house-door me-2"></i> Dashboard
                                </a>
                            </li>

                            @if (isAdmin || isHr)
                            {
                            <li class="nav-item mb-2">
                                    <a asp-controller="Intern" asp-action="Index"
                                       class="nav-link text-white @(currentController == "Intern" ? "active bg-primary" : "")">
                                        <i class="bi bi-people me-2"></i> Interns
                                    </a>
                                </li>
                            }

                            @if (isAdmin)
                            {
                                <li class="nav-item mb-2">
                                    <a asp-controller="Department" asp-action="Index"
                                       class="nav-link text-white @(currentController == "Department" ? "active bg-primary" : "")">
                                        <i class="bi bi-building me-2"></i> Departments
                                    </a>
                                </li>

                                <li class="nav-item mb-2">
                                    <a asp-controller="User" asp-action="Index"
                                       class="nav-link text-white @(currentController == "User" ? "active bg-primary" : "")">
                                        <i class="bi bi-person-gear me-2"></i> Users
                                    </a>
                                </li>
                            }

                            <li class="nav-item mb-2">
                                <a asp-controller="Task" asp-action="Index"
                                   class="nav-link text-white @(currentController == "Task" ? "active bg-primary" : "")">
                                    <i class="bi bi-list-check me-2"></i> Tasks
                                </a>
                            </li>

                            <li class="nav-item mb-2">
                                <a asp-controller="Attendance" asp-action="Index"
                                   class="nav-link text-white @(currentController == "Attendance" ? "active bg-primary" : "")">
                                    <i class="bi bi-calendar-check me-2"></i> Attendance
                                </a>
                            </li>

                            <li class="nav-item mb-2">
                                <a asp-controller="Leave" asp-action="Index"
                                   class="nav-link text-white @(currentController == "Leave" ? "active bg-primary" : "")">
                                    <i class="bi bi-calendar2-minus me-2"></i> Leave Requests
                                </a>
                            </li>

                            <li class="nav-item mb-2">
                                <a asp-controller="ProgressReport" asp-action="Index"
                                   class="nav-link text-white @(currentController == "ProgressReport" ? "active bg-primary" : "")">
                                    <i class="bi bi-bar-chart me-2"></i> Progress Reports
                                </a>
                            </li>

                            <li class="nav-item mt-4 pt-3 border-top border-secondary">
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="nav-link text-danger bg-transparent border-0 w-100 text-start">
                                        <i class="bi bi-box-arrow-right me-2"></i> Logout
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item mt-4">
                                <a asp-controller="Account" asp-action="Login" class="nav-link text-white">
                                    <i class="bi bi-box-arrow-in-right me-2"></i> Login
                                </a>
                            </li>
                        }
                    </ul>
                </aside>
            }

            <!-- Main Content Area -->
            <main class="main-content flex-grow-1 p-3 p-md-4">
                <partial name="_Alerts" />
                @RenderBody()
            </main>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IMS.Web</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/IMS.Web.styles.css" asp-append-version="true" />
</head>
<body>

   

    <div class="container-fluid">

        <div class="row">

            <!-- Sidebar -->

            <div class="col-md-2 bg-dark text-white min-vh-100 p-3">

                <h4 class="text-center mb-4">IMS</h4>

                <ul class="nav flex-column">

                    <li class="nav-item mb-2">
                        <a asp-controller="Dashboard"
                           asp-action="Index"
                           class="nav-link text-white @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "bg-primary rounded" : "")">
                            <i class="bi bi-house-door me-2"></i>
                            Dashboard
                        </a>
                    </li>

                    <li class="nav-item mb-2">
                        <a asp-controller="Intern"
                           asp-action="Index"
                           class="nav-link text-white @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Intern" ? "bg-primary rounded" : "")">
                            <i class="bi bi-people me-2"></i>
                            Interns
                        </a>
                    </li>

                    <li class="nav-item mb-2">
                        <a asp-controller="Department"
                           asp-action="Index"
                           class="nav-link text-white @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Department" ? "bg-primary rounded" : "")">
                            <i class="bi bi-building me-2"></i>
                            Departments
                        </a>
                    </li>

                    <li class="nav-item mb-2">
                        <a asp-controller="User"
                           asp-action="Index"
                           class="nav-link text-white @(ViewContext.RouteData.Values["Controller"]?.ToString() == "User" ? "bg-primary rounded" : "")">
                            <i class="bi bi-mortarboard me-2"></i>
                            Users
                        </a>
                    </li>
                    <li class="nav-item mb-2">
                        <a asp-controller="Mentor"
                           asp-action="Index"
                           class="nav-link text-white @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Mentor" ? "bg-primary rounded" : "")">
                            <i class="bi bi-person-workspace me-2"></i>
                            Mentors
                        </a>
                    </li>

                    <li class="nav-item mb-2">
                        <a asp-controller="Task"
                           asp-action="Index"
                           class="nav-link text-white @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Task" ? "bg-primary rounded" : "")">

                            <i class="bi bi-list-check me-2"></i>
                            Tasks

                        </a>
                    </li>

                    <li class="nav-item mb-2">
                        <a asp-controller="Attendance"
                           asp-action="Index"
                           class="nav-link text-white @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Attendance" ? "bg-primary rounded" : "")">

                            <i class="bi bi-calendar-check me-2"></i>
                            Attendance

                        </a>
                    </li>

                    <li class="nav-item mb-2">

                        <a asp-controller="Leave"
                           asp-action="Index"
                           class="nav-link text-white @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Leave" ? "bg-primary rounded" : "")">

                            <i class="bi bi-calendar2-minus me-2"></i>
                            Leave

                        </a>

                    </li>

                    <li class="nav-item mb-2">
                        <a href="#" class="nav-link text-white">
                            <i class="bi bi-bar-chart me-2"></i>
                            Reports
                        </a>
                    </li>

                    <li class="nav-item mt-4">
                        <a asp-controller="Account"
                           asp-action="Logout"
                           class="nav-link text-danger">
                            <i class="bi bi-box-arrow-right me-2"></i>
                            Logout
                        </a>
                    </li>

                </ul>

            </div>

            <!-- Main Content -->

            <div class="col-md-10 p-4">

                @RenderBody()

            </div>

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
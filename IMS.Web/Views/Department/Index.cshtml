@model IEnumerable<IMS.Web.Models.Department>

<div class="container mt-5">

    @if (TempData["Success"] != null)
    {
        <div id="successAlert" class="alert alert-success alert-dismissible fade show">

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    <script>
            setTimeout(function () {

                let alert = document.getElementById("successAlert");

                if (alert) {
                    alert.style.display = "none";
                }

            }, 3000);
    </script>

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>Department Management</h2>

        <a asp-action="Create" class="btn btn-primary">
            + Add Department
        </a>

    </div>
    <form method="get" class="mb-3">

        <div class="input-group">

            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   class="form-control"
                   placeholder="Search department..." />

            <button class="btn btn-primary">
                Search
            </button>

        </div>

    </form>

    <table class="table table-bordered table-hover table-striped shadow">

        <thead class="table-dark">

            <tr>
                <th>ID</th>
                <th>Department Name</th>
                <th width="180">Actions</th>
            </tr>

        </thead>

        <tbody>

            @foreach (var department in Model)
            {
                <tr>

                    <td>@department.Id</td>
                    <td>@department.Name</td>

                    <td>

                        <a asp-action="Edit"
                           asp-route-id="@department.Id"
                           class="btn btn-warning btn-sm">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@department.Id"
                           class="btn btn-danger btn-sm">
                            Delete
                        </a>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>
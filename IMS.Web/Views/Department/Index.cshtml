@model IEnumerable<IMS.Web.Models.Department>

@{
    ViewData["Title"] = "Departments";
}

<div class="container mt-5">

    @* System Alert Feedback *@
    @if (TempData["Success"] != null)
    {
        <div id="successAlert" class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div id="errorAlert" class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">Department Management</h2>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Add Department
        </a>
    </div>

    @* Search Form *@
    <form method="get" class="mb-4">
        <div class="input-group shadow-sm">
            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   class="form-control"
                   placeholder="Search department..." />
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-search me-1"></i> Search
            </button>
            @if (!string.IsNullOrEmpty(ViewBag.Search as string))
            {
                <a asp-action="Index" class="btn btn-outline-secondary">
                    Clear
                </a>
            }
        </div>
    </form>

    @* Data Table *@
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 80px;">ID</th>
                        <th>Department Name</th>
                        <th style="width: 180px;" class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var department in Model)
                        {
                            <tr>
                                <td class="fw-bold">@department.Id</td>
                                <td>@department.Name</td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Edit"
                                           asp-route-id="@department.Id"
                                           class="btn btn-warning">
                                            <i class="bi bi-pencil me-1"></i> Edit
                                        </a>
                                        <a asp-action="Delete"
                                           asp-route-id="@department.Id"
                                           class="btn btn-danger">
                                            <i class="bi bi-trash me-1"></i> Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                No departments found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const successAlert = document.getElementById("successAlert");
            if (successAlert) {
                setTimeout(function () {
                    const alertInstance = bootstrap.Alert.getOrCreateInstance(successAlert);
                    alertInstance.close();
                }, 3000);
            }
        });
    </script>
}
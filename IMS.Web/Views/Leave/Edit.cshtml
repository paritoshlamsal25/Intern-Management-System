@model IMS.Web.Models.LeaveRequest

<div class="container mt-5">

    <div class="card shadow">

        <div class="card-header bg-warning">
            <h3>Edit Leave Request</h3>
        </div>

        <div class="card-body">

            <form method="post">

                <input asp-for="Id" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">

                    <label asp-for="InternId"
                           class="form-label">
                        Intern
                    </label>

                    <select asp-for="InternId"
                            class="form-select">

                        @foreach (var intern in ViewBag.Interns)
                        {
                            <option value="@intern.Id">
                                @intern.Name
                            </option>
                        }

                    </select>

                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="StartDate"
                               class="form-label">
                            Start Date
                        </label>

                        <input asp-for="StartDate"
                               type="date"
                               class="form-control" />

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="EndDate"
                               class="form-label">
                            End Date
                        </label>

                        <input asp-for="EndDate"
                               type="date"
                               class="form-control" />

                    </div>

                </div>

                <div class="mb-3">

                    <label asp-for="Reason"
                           class="form-label">
                        Reason
                    </label>

                    <textarea asp-for="Reason"
                              class="form-control"
                              rows="4"></textarea>

                </div>

                <button type="submit"
                        class="btn btn-success">
                    Update
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Back
                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
@model IEnumerable<IMS.Web.Models.LeaveRequest>

@{
    ViewData["Title"] = "Leave Management";
}

<div class="container mt-4">

    @* System Alert Feedback *@
    @if (TempData["Success"] != null)
    {
        <div id="successAlert" class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div id="errorAlert" class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">Leave Management</h2>
        @if (!User.IsInRole("Mentor"))
        {
            <a asp-action="Create" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Request Leave
            </a>
        }
    </div>

    @* Search Form *@
    <form method="get" class="mb-4">
        <div class="input-group shadow-sm">
            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   class="form-control"
                   placeholder="Search by intern name..." />
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-search me-1"></i> Search
            </button>
            @if (!string.IsNullOrEmpty(ViewBag.Search as string))
            {
                <a asp-action="Index" class="btn btn-outline-secondary">
                    Clear
                </a>
            }
        </div>
    </form>

    @* Leave Table Container *@
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0 align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Intern</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Reason</th>
                            <th>Status</th>
                            <th style="width: 260px;" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var leave in Model)
                            {
                                <tr>
                                    <td class="fw-bold">@(leave.Intern?.Name ?? "Unassigned")</td>
                                    <td>@leave.StartDate.ToString("yyyy-MM-dd")</td>
                                    <td>@leave.EndDate.ToString("yyyy-MM-dd")</td>
                                    <td class="small text-truncate" style="max-width: 250px;" title="@leave.Reason">
                                        @(string.IsNullOrWhiteSpace(leave.Reason) ? "-" : leave.Reason)
                                    </td>
                                    <td>
                                        @switch (leave.Status)
                                        {
                                            case "Approved":
                                                <span class="badge bg-success">Approved</span>
                                                break;
                                            case "Rejected":
                                                <span class="badge bg-danger">Rejected</span>
                                                break;
                                            case "Pending":
                                                <span class="badge bg-warning text-dark">Pending</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary">@(leave.Status ?? "N/A")</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            @if ((User.IsInRole("Admin") || User.IsInRole("HR")) && leave.Status == "Pending")
                                            {
                                                <form asp-action="Approve" asp-route-id="@leave.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-success" title="Approve">
                                                        <i class="bi bi-check-lg"></i>
                                                    </button>
                                                </form>

                                                <form asp-action="Reject" asp-route-id="@leave.Id" method="post" class="d-inline me-1">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-outline-danger" title="Reject">
                                                        <i class="bi bi-x-lg"></i>
                                                    </button>
                                                </form>
                                            }

                                            @if (User.IsInRole("Admin") || User.IsInRole("HR") || (User.IsInRole("Intern") && leave.Status == "Pending"))
                                            {
                                                <a asp-action="Edit"
                                                   asp-route-id="@leave.Id"
                                                   class="btn btn-warning" title="Edit">
                                                    <i class="bi bi-pencil me-1"></i> Edit
                                                </a>
                                                <a asp-action="Delete"
                                                   asp-route-id="@leave.Id"
                                                   class="btn btn-danger" title="Delete">
                                                    <i class="bi bi-trash me-1"></i> Delete
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                    No leave requests found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const successAlert = document.getElementById("successAlert");
            if (successAlert) {
                setTimeout(function () {
                    const alertInstance = bootstrap.Alert.getOrCreateInstance(successAlert);
                    alertInstance.close();
                }, 3000);
            }
        });
    </script>
}
@model IEnumerable<IMS.Web.Models.LeaveRequest>

<div class="container mt-4">

    @if (TempData["Success"] != null)
    {
        <div id="successAlert"
             class="alert alert-success alert-dismissible fade show">

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>Leave Management</h2>

        <a asp-action="Create"
           class="btn btn-primary">
            + Request Leave
        </a>

    </div>

    <form method="get" class="mb-3">

        <div class="input-group">

            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   class="form-control"
                   placeholder="Search by intern name..." />

            <button type="submit"
                    class="btn btn-primary">
                Search
            </button>

        </div>

    </form>

    @if (Model.Any())
    {
        <table class="table table-bordered table-hover shadow">

            <thead class="table-dark">

                <tr>
                    <th>Intern</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Reason</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>

            </thead>

            <tbody>

                @foreach (var leave in Model)
                {
                    <tr>

                        <td>@leave.Intern?.Name</td>

                        <td>
                            @leave.StartDate.ToString("yyyy-MM-dd")
                        </td>

                        <td>
                            @leave.EndDate.ToString("yyyy-MM-dd")
                        </td>

                        <td>@leave.Reason</td>

                        <td>

                            @if (leave.Status == "Approved")
                            {
                                <span class="badge bg-success">
                                    Approved
                                </span>
                            }
                            else if (leave.Status == "Rejected")
                            {
                                <span class="badge bg-danger">
                                    Rejected
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">
                                    Pending
                                </span>
                            }

                        </td>

                        <td>

                            @if (leave.Status == "Pending")
                            {
                                <form asp-action="Approve"
                                      asp-route-id="@leave.Id"
                                      method="post"
                                      class="d-inline">

                                    <button type="submit"
                                            class="btn btn-success btn-sm">
                                        Approve
                                    </button>

                                </form>

                                <form asp-action="Reject"
                                      asp-route-id="@leave.Id"
                                      method="post"
                                      class="d-inline">

                                    <button type="submit"
                                            class="btn btn-danger btn-sm">
                                        Reject
                                    </button>

                                </form>
                            }

                            <a asp-action="Edit"
                               asp-route-id="@leave.Id"
                               class="btn btn-warning btn-sm">
                                Edit
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@leave.Id"
                               class="btn btn-secondary btn-sm">
                                Delete
                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>
    }
    else
    {
        <div class="alert alert-warning text-center">
            No leave requests found.
        </div>
    }

</div>

<script>

    setTimeout(function () {

        let alert = document.getElementById("successAlert");

        if (alert) {
            alert.style.display = "none";
        }

    }, 3000);

</script>
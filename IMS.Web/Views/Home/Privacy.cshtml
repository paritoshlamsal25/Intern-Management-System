@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container mt-5">
    <div class="card shadow border-0">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0"><i class="bi bi-shield-check me-2"></i>@ViewData["Title"]</h3>
        </div>

        <div class="card-body p-4">
            <p class="lead text-muted">
                Your privacy is important to us. This policy outlines how the <strong>Internship Management System (IMS)</strong> handles user information, attendance records, and data security.
            </p>

            <hr class="my-4" />

            <div class="row g-4">
                <div class="col-md-6">
                    <h5 class="fw-bold"><i class="bi bi-person-badge text-primary me-2"></i>Data Collection</h5>
                    <p class="text-secondary small">
                        IMS collects basic profile information, daily clock-in/clock-out timestamps, task submissions, and leave requests purely for internal administration and performance tracking.
                    </p>
                </div>

                <div class="col-md-6">
                    <h5 class="fw-bold"><i class="bi bi-lock text-primary me-2"></i>Security & Protection</h5>
                    <p class="text-secondary small">
                        All user data is guarded by role-based access controls (RBAC) and CSRF anti-forgery protection. Audit logs track system modifications to maintain transparency.
                    </p>
                </div>
            </div>

            <div class="mt-4 pt-3 border-top d-flex justify-content-between align-items-center">
                <small class="text-muted">Last updated: September 2026</small>
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Return to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>
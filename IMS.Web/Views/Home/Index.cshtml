@{
    ViewData["Title"] = "Welcome";
}

<div class="container-fluid p-0">
    @* Hero Section *@
    <div class="home-hero text-white text-center py-5 shadow-sm" style="background: linear-gradient(135deg, #0d6efd 0%, #6610f2 100%); min-height: 400px; display: flex; align-items: center;">
        <div class="container my-auto">
            <h1 class="display-3 fw-bold mb-3">Welcome to IMS</h1>
            <p class="lead mb-4 fs-4 text-white-50">
                Streamline intern attendance, tasks, leaves, and system reports in one centralized portal.
            </p>

            <div class="d-flex justify-content-center gap-3">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-light btn-lg px-4 shadow-sm fw-bold text-primary">
                        <i class="bi bi-speedometer2 me-2"></i> Go to Dashboard
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-light btn-lg px-4 shadow-sm fw-bold text-primary">
                        <i class="bi bi-box-arrow-in-right me-2"></i> Login
                    </a>
                }

                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="User" asp-action="Index" class="btn btn-outline-light btn-lg px-4">
                        <i class="bi bi-people-fill me-2"></i> Manage Users
                    </a>
                }
            </div>
        </div>
    </div>

    @* Feature Highlights Cards *@
    <div class="container my-5">
        <div class="row g-4 text-center">
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm p-3">
                    <div class="card-body">
                        <div class="fs-1 text-primary mb-3">
                            <i class="bi bi-calendar-check"></i>
                        </div>
                        <h4 class="fw-bold">Attendance Tracking</h4>
                        <p class="text-muted">
                            Clock in daily, log hours, and track attendance history seamlessly.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm p-3">
                    <div class="card-body">
                        <div class="fs-1 text-success mb-3">
                            <i class="bi bi-list-task"></i>
                        </div>
                        <h4 class="fw-bold">Task Management</h4>
                        <p class="text-muted">
                            Assign, update, and review intern daily tasks and progress reports.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm p-3">
                    <div class="card-body">
                        <div class="fs-1 text-warning mb-3">
                            <i class="bi bi-shield-lock"></i>
                        </div>
                        <h4 class="fw-bold">Role-Based Access</h4>
                        <p class="text-muted">
                            Tailored views and security permissions for Admins, HR, Mentors, and Interns.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
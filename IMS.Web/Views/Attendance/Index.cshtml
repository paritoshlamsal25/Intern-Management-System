@model IEnumerable<IMS.Web.Models.Attendance>

@{
    ViewData["Title"] = "Attendance Management";
}

<div class="container mt-4">

    @* System Alert Feedback *@
    @if (TempData["Success"] != null)
    {
        <div id="successAlert" class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div id="errorAlert" class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">Attendance Management</h2>
        @if (!User.IsInRole("Mentor"))
        {
            <a asp-action="Create" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Mark Attendance
            </a>
        }
    </div>

    @* Search Form *@
    <form method="get" class="mb-4">
        <div class="input-group shadow-sm">
            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   class="form-control"
                   placeholder="Search by intern name..." />
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-search me-1"></i> Search
            </button>
            @if (!string.IsNullOrEmpty(ViewBag.Search as string))
            {
                <a asp-action="Index" class="btn btn-outline-secondary">
                    Clear
                </a>
            }
        </div>
    </form>

    @* Attendance Table *@
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Intern</th>
                        <th>Date</th>
                        <th>Status</th>
                        @if (User.IsInRole("Admin") || User.IsInRole("HR"))
                        {
                            <th style="width: 180px;" class="text-center">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var attendance in Model)
                        {
                            <tr>
                                <td class="fw-bold">@(attendance.Intern?.Name ?? "N/A")</td>
                                <td>@attendance.Date.ToString("yyyy-MM-dd")</td>
                                <td>
                                    @switch (attendance.Status)
                                    {
                                        case "Present":
                                            <span class="badge bg-success">Present</span>
                                            break;
                                        case "Late":
                                            <span class="badge bg-warning text-dark">Late</span>
                                            break;
                                        case "Absent":
                                            <span class="badge bg-danger">Absent</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">@attendance.Status</span>
                                            break;
                                    }
                                </td>
                                @if (User.IsInRole("Admin") || User.IsInRole("HR"))
                                {
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Edit"
                                               asp-route-id="@attendance.Id"
                                               class="btn btn-warning">
                                                <i class="bi bi-pencil me-1"></i> Edit
                                            </a>
                                            <a asp-action="Delete"
                                               asp-route-id="@attendance.Id"
                                               class="btn btn-danger">
                                                <i class="bi bi-trash me-1"></i> Delete
                                            </a>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="@(User.IsInRole("Admin") || User.IsInRole("HR") ? 4 : 3)" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                No attendance records found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const successAlert = document.getElementById("successAlert");
            if (successAlert) {
                setTimeout(function () {
                    const alertInstance = bootstrap.Alert.getOrCreateInstance(successAlert);
                    alertInstance.close();
                }, 3000);
            }
        });
    </script>
}
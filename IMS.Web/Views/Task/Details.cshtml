@model IMS.Web.Models.TaskItem

@{
    ViewData["Title"] = "Task Details & Submission";
    var isIntern = User.IsInRole("Intern");
    var isMentor = User.IsInRole("Mentor");
    var isAdminOrHr = User.IsInRole("Admin") || User.IsInRole("HR");
    var canReview = isMentor || isAdminOrHr;
    var hasSubmission = !string.IsNullOrEmpty(Model.SubmissionNote) || !string.IsNullOrEmpty(Model.SubmissionFilePath);
}

<div class="container-fluid py-3">

    @* Alert Feedback *@
    @if (TempData["Success"] != null)
    {
        <div id="successAlert" class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Header Breadcrumb & Actions -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Tasks</a></li>
                    <li class="breadcrumb-item active" aria-current="page">#@Model.Id @Model.Title</li>
                </ol>
            </nav>
            <h3 class="fw-bold mb-0 text-dark">
                <i class="bi bi-journal-text text-primary me-2"></i>@Model.Title
            </h3>
        </div>
        <div class="d-flex gap-2">
            @if (canReview)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary shadow-sm">
                    <i class="bi bi-pencil-square me-1"></i> Edit Task
                </a>
            }
            <a asp-action="Index" class="btn btn-secondary shadow-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Tasks
            </a>
        </div>
    </div>

    <div class="row g-4">

        <!-- Task Info & Requirements -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-info-circle text-primary me-2"></i>Task Information & Instructions
                    </h5>
                    @{
                        var statusClass = Model.Status switch
                        {
                            "Completed"  => "bg-success",
                            "In Progress" => "bg-info text-dark",
                            "Submitted"  => "bg-warning text-dark",
                            _            => "bg-secondary"
                        };
                    }
                    <span class="badge @statusClass px-3 py-2 rounded-pill">
                        @(Model.Status == "Submitted" ? "⏳ Submitted – Awaiting Review" : Model.Status)
                    </span>
                </div>
                <div class="card-body p-4 pt-2">

                    <div class="mb-4">
                        <h6 class="text-muted small fw-bold text-uppercase mb-2">Description / Objectives</h6>
                        <div class="p-3 bg-light rounded-3 text-dark fs-6" style="white-space: pre-wrap;">@(string.IsNullOrWhiteSpace(Model.Description) ? "No detailed instructions provided." : Model.Description)</div>
                    </div>

                    <!-- Assignment Attachment -->
                    <div class="mb-4">
                        <h6 class="text-muted small fw-bold text-uppercase mb-2">Assignment Attachment</h6>
                        @if (!string.IsNullOrEmpty(Model.AttachmentPath))
                        {
                            <div class="p-3 bg-primary bg-opacity-10 border border-primary-subtle rounded-3 d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-file-earmark-pdf fs-2 text-danger"></i>
                                    <div>
                                        <div class="fw-bold text-dark">@(Model.AttachmentFileName ?? "Assignment Attachment")</div>
                                        <span class="small text-muted">Uploaded by Mentor / Supervisor</span>
                                    </div>
                                </div>
                                <a href="@Model.AttachmentPath" target="_blank" download class="btn btn-sm btn-primary shadow-sm px-3">
                                    <i class="bi bi-download me-1"></i> Download File
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="p-3 bg-light text-muted rounded-3 small">
                                <i class="bi bi-paperclip me-1"></i> No attachment file was attached to this task.
                            </div>
                        }
                    </div>

                    <!-- Metadata Grid -->
                    <div class="row g-3 border-top pt-3">
                        <div class="col-sm-6">
                            <span class="text-muted small d-block">Assigned Intern</span>
                            <strong class="text-dark">@(Model.Intern?.Name ?? "Unassigned")</strong>
                            <span class="text-muted small d-block">@(Model.Intern?.Email)</span>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted small d-block">Assigned Mentor</span>
                            <strong class="text-dark">@(Model.Intern?.Mentor?.FullName ?? "Unassigned")</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted small d-block">Due Date</span>
                            <strong class="text-dark"><i class="bi bi-calendar-event me-1"></i>@Model.DueDate.ToString("MMM dd, yyyy")</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted small d-block">Created Date</span>
                            <span class="text-dark">@Model.CreatedDate.ToString("MMM dd, yyyy")</span>
                        </div>
                        @if (Model.CompletedDate.HasValue)
                        {
                            <div class="col-sm-6">
                                <span class="text-muted small d-block">Completed Date</span>
                                <span class="text-success fw-bold"><i class="bi bi-check-circle me-1"></i>@Model.CompletedDate.Value.ToString("MMM dd, yyyy")</span>
                            </div>
                        }
                    </div>

                </div>
            </div>
        </div>

        <!-- Intern Submission & Review Section -->
        <div class="col-lg-5">

            <!-- Submission Status Card -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white py-3 border-0">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-send-check text-success me-2"></i>Intern Work Submission
                    </h5>
                </div>
                <div class="card-body p-4 pt-2">

                    @if (hasSubmission)
                    {
                        <div class="alert alert-success border-0 bg-success bg-opacity-10 mb-3">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                <strong class="text-success">Submission Received</strong>
                            </div>
                            <span class="small text-muted">
                                Submitted on @(Model.SubmittedDate?.ToString("MMM dd, yyyy hh:mm tt") ?? "Recently")
                            </span>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.SubmissionNote))
                        {
                            <div class="mb-3">
                                <label class="text-muted small fw-bold text-uppercase mb-1">Intern's Message / Notes:</label>
                                <div class="p-3 bg-light rounded-3 text-dark small" style="white-space: pre-wrap;">@Model.SubmissionNote</div>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(Model.SubmissionFilePath))
                        {
                            <div class="mb-3">
                                <label class="text-muted small fw-bold text-uppercase mb-1">Submitted Solution / File:</label>
                                <div class="p-3 bg-white border rounded-3 d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-file-earmark-code fs-3 text-primary"></i>
                                        <span class="small fw-semibold text-truncate" style="max-width: 180px;">@(Model.SubmissionFileName ?? "Solution Submission")</span>
                                    </div>
                                    <a href="@Model.SubmissionFilePath" target="_blank" download class="btn btn-sm btn-outline-success">
                                        <i class="bi bi-download me-1"></i> Download
                                    </a>
                                </div>
                            </div>
                        }

                        @* ─── MENTOR / ADMIN REVIEW PANEL ─── *@
                        @if (canReview && Model.Status == "Submitted")
                        {
                            <div class="border-top pt-3 mt-3">
                                <h6 class="fw-bold text-dark mb-3">
                                    <i class="bi bi-clipboard2-check text-warning me-1"></i> Review & Approve Submission
                                </h6>
                                <div class="d-flex gap-2">
                                    <form asp-action="UpdateStatus" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@Model.Id" />
                                        <input type="hidden" name="status" value="Completed" />
                                        <button type="submit" class="btn btn-success fw-bold shadow-sm">
                                            <i class="bi bi-check-circle-fill me-1"></i> Mark as Completed
                                        </button>
                                    </form>
                                    <form asp-action="UpdateStatus" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@Model.Id" />
                                        <input type="hidden" name="status" value="Pending" />
                                        <button type="submit" class="btn btn-outline-warning fw-bold shadow-sm">
                                            <i class="bi bi-arrow-counterclockwise me-1"></i> Send Back / Pending
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                        else if (canReview && Model.Status == "Completed")
                        {
                            <div class="border-top pt-3 mt-3 text-center">
                                <span class="badge bg-success fs-6 px-4 py-2 rounded-pill">
                                    <i class="bi bi-trophy-fill me-1"></i> Task Completed & Approved
                                </span>
                                @if (Model.CompletedDate.HasValue)
                                {
                                    <div class="text-muted small mt-2">Approved on @Model.CompletedDate.Value.ToString("MMM dd, yyyy")</div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="p-4 text-center text-muted bg-light rounded-3 mb-3">
                            <i class="bi bi-hourglass text-warning fs-1 d-block mb-2"></i>
                            No work submission uploaded yet.
                        </div>
                    }

                    @* ─── INTERN SUBMISSION FORM ─── *@
                    @if (isIntern && Model.Status != "Completed")
                    {
                        <hr class="my-4" />
                        <h6 class="fw-bold text-dark mb-3">
                            <i class="bi bi-cloud-upload text-primary me-1"></i> @(hasSubmission ? "Update Your Submission" : "Submit Your Work")
                        </h6>

                        <form asp-action="SubmitWork" method="post" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />

                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-muted">Status</label>
                                <select name="status" class="form-select form-select-sm">
                                    <option value="In Progress" selected="@(Model.Status == "In Progress" || Model.Status == "Pending")">Working / In Progress</option>
                                    <option value="Submitted" selected="@(Model.Status == "Submitted")">Submitted – Done, awaiting mentor review</option>
                                </select>
                                <div class="form-text text-muted">
                                    <i class="bi bi-info-circle me-1"></i>
                                    Only your mentor can mark this task as <strong>Completed</strong>.
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-muted">Progress Notes / Message to Mentor</label>
                                <textarea name="submissionNote" class="form-control form-control-sm" rows="3" placeholder="Describe what you built, any blockers, or completion notes...">@Model.SubmissionNote</textarea>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-muted">Upload Solution File (PDF, ZIP, DOCX, Code)</label>
                                <input type="file" name="submissionFile" class="form-control form-control-sm" />
                            </div>

                            <button type="submit" class="btn btn-primary btn-sm w-100 py-2 fw-bold shadow-sm">
                                <i class="bi bi-send-fill me-1"></i> Send to Mentor
                            </button>
                        </form>
                    }
                    else if (isIntern && Model.Status == "Completed")
                    {
                        <div class="text-center py-3">
                            <span class="badge bg-success fs-6 px-4 py-2 rounded-pill">
                                <i class="bi bi-trophy-fill me-1"></i> Task Completed!
                            </span>
                            <div class="text-muted small mt-2">Your mentor has approved this submission.</div>
                        </div>
                    }

                </div>
            </div>

        </div>

    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const successAlert = document.getElementById("successAlert");
            if (successAlert) {
                setTimeout(() => bootstrap.Alert.getOrCreateInstance(successAlert).close(), 4000);
            }
        });
    </script>
}

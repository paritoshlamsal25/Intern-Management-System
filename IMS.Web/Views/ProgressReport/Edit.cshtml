@model IMS.Web.Models.ProgressReport
@using IMS.Web.Models

@{
    ViewData["Title"] = "Edit Progress Report";
    var interns = ViewBag.Interns as List<Intern> ?? new List<Intern>();
    var tasks = ViewBag.Tasks as List<TaskItem> ?? new List<TaskItem>();
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1"><i class="bi bi-pencil-square text-warning me-2"></i>Edit Progress Report #@Model.Id</h3>
            <p class="text-muted small mb-0">Update evaluation marks, topic, task link, and mentor notes.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to Reports
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                        @* Intern (readonly in edit) *@
                        <div class="mb-4">
                            <label class="form-label fw-bold">
                                <i class="bi bi-person-circle text-primary me-1"></i> Intern
                            </label>
                            <input type="hidden" asp-for="InternId" />
                            <input type="text" class="form-control bg-light"
                                   value="@(Model.Intern?.Name ?? "Unknown") — @(Model.Intern?.Email)" readonly />
                        </div>

                        @* Task picker *@
                        <div class="mb-4">
                            <label asp-for="TaskId" class="form-label fw-bold">
                                <i class="bi bi-list-check text-success me-1"></i> Linked Task / Assignment
                                <span class="badge bg-secondary ms-1 fw-normal">Optional</span>
                            </label>
                            <select asp-for="TaskId" class="form-select">
                                <option value="">-- No task linked --</option>
                                @{
                                    var submitted = tasks.Where(t => t.Status == "Submitted" || t.Status == "Completed").ToList();
                                    var others = tasks.Where(t => t.Status != "Submitted" && t.Status != "Completed").ToList();
                                }
                                @if (submitted.Any())
                                {
                                    <optgroup label="✅ Submitted / Completed Tasks">
                                        @foreach (var t in submitted)
                                        {
                                            <option value="@t.Id" selected="@(Model.TaskId == t.Id)">@t.Title</option>
                                        }
                                    </optgroup>
                                }
                                @if (others.Any())
                                {
                                    <optgroup label="⚠️ Not Yet Submitted">
                                        @foreach (var t in others)
                                        {
                                            <option value="@t.Id" selected="@(Model.TaskId == t.Id)">@t.Title</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                        </div>

                        @* Manual reference *@
                        <div class="mb-4">
                            <label asp-for="AssignmentReference" class="form-label fw-bold">
                                <i class="bi bi-journal-text text-warning me-1"></i> Assignment / Resource Reference
                                <span class="badge bg-secondary ms-1 fw-normal">Optional</span>
                            </label>
                            <input asp-for="AssignmentReference" class="form-control"
                                   placeholder="e.g., REST API Design – Week 3 Assignment (not submitted)" />
                        </div>

                        <hr class="my-3" />

                        @* Topic & Marks *@
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Topic" class="form-label fw-bold">
                                    <i class="bi bi-tag text-info me-1"></i> Topic / Evaluation Area
                                </label>
                                <input asp-for="Topic" class="form-control"
                                       placeholder="e.g., React Hooks, API Design..." />
                                <span asp-validation-for="Topic" class="text-danger small"></span>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="Marks" class="form-label fw-bold">
                                    <i class="bi bi-star-fill text-warning me-1"></i> Marks Obtained
                                </label>
                                <input asp-for="Marks" type="number" min="0" class="form-control"
                                       id="marksInput" oninput="updateScore()" />
                                <span asp-validation-for="Marks" class="text-danger small"></span>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="MaxMarks" class="form-label fw-bold">
                                    <i class="bi bi-trophy text-success me-1"></i> Out of (Max)
                                </label>
                                <select asp-for="MaxMarks" class="form-select" id="maxMarksSelect" onchange="updateScore()">
                                    <option value="">-- Select --</option>
                                    <option value="50">50</option>
                                    <option value="100">100</option>
                                    <option value="150">150</option>
                                    <option value="200">200</option>
                                    <option value="500">500</option>
                                </select>
                                <span asp-validation-for="MaxMarks" class="text-danger small"></span>
                            </div>
                        </div>

                        <div id="scorePreview" class="alert alert-info border-0 d-none mb-4">
                            <i class="bi bi-calculator me-2"></i>
                            Score: <strong id="scoreDisplay">–</strong>
                            <span class="badge ms-2" id="scoreBadge"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Date" class="form-label fw-bold">
                                <i class="bi bi-calendar-date text-secondary me-1"></i> Report Date
                            </label>
                            <input asp-for="Date" type="date" class="form-control" style="max-width:220px;" />
                            <span asp-validation-for="Date" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Notes" class="form-label fw-bold">
                                <i class="bi bi-chat-left-text text-primary me-1"></i> Mentor Notes / Feedback
                            </label>
                            <textarea asp-for="Notes" class="form-control" rows="4"
                                      placeholder="Evaluation notes, feedback, strengths, areas to improve..."></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-warning fw-bold shadow-sm">
                                <i class="bi bi-save me-1"></i> Save Changes
                            </button>
                            <a asp-action="Index" class="btn btn-secondary shadow-sm">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        function updateScore() {
            const marks = parseInt(document.getElementById('marksInput').value);
            const max = parseInt(document.getElementById('maxMarksSelect').value);
            const preview = document.getElementById('scorePreview');
            const display = document.getElementById('scoreDisplay');
            const badge = document.getElementById('scoreBadge');
            if (!isNaN(marks) && !isNaN(max) && max > 0) {
                const pct = Math.round((marks / max) * 100);
                display.textContent = marks + ' / ' + max + ' (' + pct + '%)';
                preview.classList.remove('d-none');
                if (pct >= 80) { badge.textContent = 'Excellent'; badge.className = 'badge bg-success ms-2'; }
                else if (pct >= 60) { badge.textContent = 'Good'; badge.className = 'badge bg-info text-dark ms-2'; }
                else if (pct >= 40) { badge.textContent = 'Average'; badge.className = 'badge bg-warning text-dark ms-2'; }
                else { badge.textContent = 'Needs Improvement'; badge.className = 'badge bg-danger ms-2'; }
            } else {
                preview.classList.add('d-none');
            }
        }
        // Trigger on load
        updateScore();
    </script>
}

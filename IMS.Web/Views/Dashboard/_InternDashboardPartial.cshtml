@model IMS.Web.Models.ViewModels.InternDashboardViewModel

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h2 class="fw-bold mb-1">Welcome, @Model.InternName! 👋</h2>
        <span class="text-muted">Department: <strong>@Model.DepartmentName</strong></span>
    </div>

    @* Daily Attendance Clock-In Widget *@
    <div>
        @if (!Model.HasClockedInToday)
        {
            <form asp-controller="Attendance" asp-action="ClockIn" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success btn-lg shadow-sm">
                    <i class="bi bi-clock-fill me-1"></i> Clock In Today
                </button>
            </form>
        }
        else
        {
            <span class="badge bg-success p-2 fs-6">
                <i class="bi bi-check-circle-fill me-1"></i> Clocked In Today
            </span>
        }
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card bg-primary text-white shadow-sm border-0 h-100">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 text-white-50">Assigned Tasks</h6>
                <h2 class="card-title fw-bold mb-0">@Model.AssignedTasksCount</h2>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-warning text-dark shadow-sm border-0 h-100">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 text-dark-50">In Progress / Pending</h6>
                <h2 class="card-title fw-bold mb-0">@Model.PendingTasksCount</h2>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-success text-white shadow-sm border-0 h-100">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 text-white-50">Completed Tasks</h6>
                <h2 class="card-title fw-bold mb-0">@Model.CompletedTasksCount</h2>
            </div>
        </div>
    </div>
</div>
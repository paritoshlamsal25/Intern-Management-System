@model IMS.Web.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    var isAdmin = User.IsInRole("Admin");
    var isHr = User.IsInRole("HR");
    var isMentor = User.IsInRole("Mentor");
    var isIntern = User.IsInRole("Intern");
    var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "User";
}

<div class="container-fluid py-3">

    @* ==========================================
       1. WELCOME HEADER BANNER
       ========================================== *@
    <div class="card border-0 rounded-4 shadow-sm mb-4 text-white" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);">
        <div class="card-body p-4 p-md-5">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div>
                    <span class="badge bg-white text-primary px-3 py-2 rounded-pill fw-bold mb-2 shadow-sm">
                        <i class="bi bi-shield-check me-1"></i> @userRole Role
                    </span>
                    <h2 class="fw-bold mb-1 display-6">
                        Welcome back, @(User.Identity?.Name ?? "User")! 👋
                    </h2>
                    <p class="text-white-50 mb-0 fs-6">
                        @if (isAdmin)
                        {
                            <span>Enterprise Admin Dashboard - Monitor interns, departments, system tasks, and approvals.</span>
                        }
                        else if (isHr)
                        {
                            <span>HR Dashboard - Track intern performances, attendance, and manage leave requests.</span>
                        }
                        else if (isMentor)
                        {
                            <span>Mentor Dashboard - Supervise your assigned interns, create task assignments, and review work submissions.</span>
                        }
                        else
                        {
                            <span>Intern Workspace - Track your assigned tasks, attendance status, and daily progress.</span>
                        }
                    </p>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    @if (isAdmin || isHr)
                    {
                        <a asp-controller="Intern" asp-action="Create" class="btn btn-light fw-bold text-primary shadow-sm px-3">
                            <i class="bi bi-person-plus-fill me-1"></i> Add Intern
                        </a>
                        <a asp-controller="Task" asp-action="Create" class="btn btn-outline-light fw-semibold shadow-sm px-3">
                            <i class="bi bi-plus-circle me-1"></i> Assign Task
                        </a>
                    }
                    else if (isMentor)
                    {
                        <a asp-controller="Task" asp-action="Create" class="btn btn-light fw-bold text-primary shadow-sm px-3">
                            <i class="bi bi-plus-circle me-1"></i> Assign Task
                        </a>
                        <a asp-controller="Task" asp-action="Index" class="btn btn-outline-light fw-semibold shadow-sm px-3">
                            <i class="bi bi-journal-check me-1"></i> Review Submissions
                        </a>
                    }
                    else if (isIntern)
                    {
                        <a asp-controller="Attendance" asp-action="Create" class="btn btn-warning fw-bold shadow-sm px-3">
                            <i class="bi bi-clock-history me-1"></i> Log Attendance
                        </a>
                        <a asp-controller="ProgressReport" asp-action="Create" class="btn btn-light fw-bold text-primary shadow-sm px-3">
                            <i class="bi bi-journal-plus me-1"></i> Daily Report
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>

    @* ==========================================
       2. ADMIN DASHBOARD VIEW
       ========================================== *@
    @if (isAdmin && Model.AdminData != null)
    {
        var admin = Model.AdminData;

        <!-- Metric Stat Cards -->
        <div class="row g-3 mb-4">
            <div class="col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-primary border-4">
                    <div class="card-body p-4 d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small fw-semibold text-uppercase mb-1">Total Interns</p>
                            <h2 class="fw-bold mb-0 text-dark">@admin.TotalInterns</h2>
                        </div>
                        <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle fs-3">
                            <i class="bi bi-people-fill"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-success border-4">
                    <div class="card-body p-4 d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small fw-semibold text-uppercase mb-1">Departments</p>
                            <h2 class="fw-bold mb-0 text-dark">@admin.TotalDepartments</h2>
                        </div>
                        <div class="bg-success bg-opacity-10 text-success p-3 rounded-circle fs-3">
                            <i class="bi bi-building"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-info border-4">
                    <div class="card-body p-4 d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small fw-semibold text-uppercase mb-1">System Tasks</p>
                            <h2 class="fw-bold mb-0 text-dark">@admin.TotalTasks</h2>
                        </div>
                        <div class="bg-info bg-opacity-10 text-info p-3 rounded-circle fs-3">
                            <i class="bi bi-list-check"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-warning border-4">
                    <div class="card-body p-4 d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small fw-semibold text-uppercase mb-1">Pending Leaves</p>
                            <h2 class="fw-bold mb-0 text-dark">@admin.PendingLeavesCount</h2>
                        </div>
                        <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-circle fs-3">
                            <i class="bi bi-calendar2-minus"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Admin Content Rows -->
        <div class="row g-4">
            <!-- Pending Leaves Table -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-clock-history text-warning me-2"></i>Pending Leave Requests
                        </h5>
                        <a asp-controller="Leave" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill">View All</a>
                    </div>
                    <div class="card-body p-0">
                        @if (admin.PendingLeaves != null && admin.PendingLeaves.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light small text-uppercase">
                                        <tr>
                                            <th class="ps-4">Intern</th>
                                            <th>Dates</th>
                                            <th>Reason</th>
                                            <th class="text-end pe-4">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var leave in admin.PendingLeaves)
                                        {
                                            <tr>
                                                <td class="ps-4 fw-semibold text-dark">@(leave.Intern?.Name ?? "Intern")</td>
                                                <td class="small">@leave.StartDate.ToString("MMM dd") - @leave.EndDate.ToString("MMM dd")</td>
                                                <td class="small text-truncate" style="max-width: 140px;">@leave.Reason</td>
                                                <td class="text-end pe-4">
                                                    <form asp-controller="Leave" asp-action="Approve" asp-route-id="@leave.Id" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-success rounded-circle" title="Approve">
                                                            <i class="bi bi-check"></i>
                                                        </button>
                                                    </form>
                                                    <form asp-controller="Leave" asp-action="Reject" asp-route-id="@leave.Id" method="post" class="d-inline ms-1">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle" title="Reject">
                                                            <i class="bi bi-x"></i>
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="p-4 text-center text-muted">
                                <i class="bi bi-check2-circle fs-2 text-success d-block mb-2"></i>
                                All leave requests have been reviewed!
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Recent Interns -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-mortarboard text-primary me-2"></i>Recent Interns
                        </h5>
                        <a asp-controller="Intern" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill">View All</a>
                    </div>
                    <div class="card-body p-0">
                        @if (admin.RecentInterns != null && admin.RecentInterns.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light small text-uppercase">
                                        <tr>
                                            <th class="ps-4">Intern Name</th>
                                            <th>Email</th>
                                            <th>Department</th>
                                            <th class="text-end pe-4">Mentor</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var intern in admin.RecentInterns)
                                        {
                                            <tr>
                                                <td class="ps-4 fw-semibold text-dark">@intern.Name</td>
                                                <td class="small text-muted">@intern.Email</td>
                                                <td>
                                                    <span class="badge bg-light text-primary border">@(intern.Department?.Name ?? "General")</span>
                                                </td>
                                                <td class="text-end pe-4 small text-muted">@(intern.Mentor?.FullName ?? "Unassigned")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="p-4 text-center text-muted">
                                <i class="bi bi-person-x fs-2 d-block mb-2"></i>
                                No interns registered yet.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    @{
        var isHrOnly = isHr && !isAdmin && !isMentor;
    }

    @* ==========================================
       3. HR DASHBOARD VIEW
       ========================================== *@
    @if (isHrOnly && Model.HRData != null)
    {
        var hr = Model.HRData;

        <div class="row g-3 mb-4">
            <div class="col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-primary border-4">
                    <div class="card-body p-4 d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small fw-semibold text-uppercase mb-1">Active Interns</p>
                            <h2 class="fw-bold mb-0 text-dark">@hr.ActiveInternsCount</h2>
                        </div>
                        <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle fs-3">
                            <i class="bi bi-people"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-success border-4">
                    <div class="card-body p-4 d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small fw-semibold text-uppercase mb-1">Present Today</p>
                            <h2 class="fw-bold mb-0 text-dark">@hr.TodayPresentCount</h2>
                        </div>
                        <div class="bg-success bg-opacity-10 text-success p-3 rounded-circle fs-3">
                            <i class="bi bi-calendar-check"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-warning border-4">
                    <div class="card-body p-4 d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small fw-semibold text-uppercase mb-1">Pending Leaves</p>
                            <h2 class="fw-bold mb-0 text-dark">@hr.PendingLeavesCount</h2>
                        </div>
                        <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-circle fs-3">
                            <i class="bi bi-envelope-exclamation"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-info border-4">
                    <div class="card-body p-4 d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small fw-semibold text-uppercase mb-1">Active Tasks</p>
                            <h2 class="fw-bold mb-0 text-dark">@hr.PendingTasksCount</h2>
                        </div>
                        <div class="bg-info bg-opacity-10 text-info p-3 rounded-circle fs-3">
                            <i class="bi bi-list-task"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-calendar-range text-warning me-2"></i>Pending Leave Approvals
                        </h5>
                        <a asp-controller="Leave" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill">Manage</a>
                    </div>
                    <div class="card-body p-0">
                        @if (hr.PendingLeaves != null && hr.PendingLeaves.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light small text-uppercase">
                                        <tr>
                                            <th class="ps-4">Intern</th>
                                            <th>Period</th>
                                            <th>Reason</th>
                                            <th class="text-end pe-4">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var leave in hr.PendingLeaves)
                                        {
                                            <tr>
                                                <td class="ps-4 fw-semibold text-dark">@(leave.Intern?.Name ?? "Intern")</td>
                                                <td class="small">@leave.StartDate.ToString("MMM dd") - @leave.EndDate.ToString("MMM dd")</td>
                                                <td class="small text-truncate" style="max-width: 140px;">@leave.Reason</td>
                                                <td class="text-end pe-4">
                                                    <form asp-controller="Leave" asp-action="Approve" asp-route-id="@leave.Id" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-success rounded-circle" title="Approve">
                                                            <i class="bi bi-check"></i>
                                                        </button>
                                                    </form>
                                                    <form asp-controller="Leave" asp-action="Reject" asp-route-id="@leave.Id" method="post" class="d-inline ms-1">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle" title="Reject">
                                                            <i class="bi bi-x"></i>
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="p-4 text-center text-muted">
                                <i class="bi bi-check2-circle fs-2 text-success d-block mb-2"></i>
                                No pending leave requests.
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-person-lines-fill text-primary me-2"></i>Active Interns Overview
                        </h5>
                        <a asp-controller="Intern" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill">View All</a>
                    </div>
                    <div class="card-body p-0">
                        @if (hr.RecentInterns != null && hr.RecentInterns.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light small text-uppercase">
                                        <tr>
                                            <th class="ps-4">Intern</th>
                                            <th>Department</th>
                                            <th>Mentor</th>
                                            <th class="text-end pe-4">Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var intern in hr.RecentInterns)
                                        {
                                            <tr>
                                                <td class="ps-4 fw-semibold text-dark">@intern.Name</td>
                                                <td><span class="badge bg-light text-primary border">@(intern.Department?.Name ?? "General")</span></td>
                                                <td class="small text-muted">@(intern.Mentor?.FullName ?? "Unassigned")</td>
                                                <td class="text-end pe-4">
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle">@intern.Status</span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="p-4 text-center text-muted">No interns assigned.</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    @* ==========================================
       3.5 MENTOR DASHBOARD VIEW
       ========================================== *@
    @if (isMentor && Model.MentorData != null)
    {
        var mentor = Model.MentorData;

        <!-- Mentor Stat Cards -->
        <div class="row g-3 mb-4">
            <div class="col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-primary border-4">
                    <div class="card-body p-4 d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small fw-semibold text-uppercase mb-1">My Interns</p>
                            <h2 class="fw-bold mb-0 text-dark">@mentor.AssignedInternsCount</h2>
                        </div>
                        <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle fs-3">
                            <i class="bi bi-mortarboard-fill"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-info border-4">
                    <div class="card-body p-4 d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small fw-semibold text-uppercase mb-1">Active Tasks</p>
                            <h2 class="fw-bold mb-0 text-dark">@mentor.ActiveTasksCount</h2>
                        </div>
                        <div class="bg-info bg-opacity-10 text-info p-3 rounded-circle fs-3">
                            <i class="bi bi-list-task"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-warning border-4">
                    <div class="card-body p-4 d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small fw-semibold text-uppercase mb-1">Submissions</p>
                            <h2 class="fw-bold mb-0 text-dark">@mentor.SubmittedTasksCount</h2>
                        </div>
                        <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-circle fs-3">
                            <i class="bi bi-file-earmark-check-fill"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-success border-4">
                    <div class="card-body p-4 d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small fw-semibold text-uppercase mb-1">Completed</p>
                            <h2 class="fw-bold mb-0 text-dark">@mentor.CompletedTasksCount</h2>
                        </div>
                        <div class="bg-success bg-opacity-10 text-success p-3 rounded-circle fs-3">
                            <i class="bi bi-check-circle-fill"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Mentor Content Rows -->
        <div class="row g-4">
            
            <!-- Recent Intern Submissions -->
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-cloud-arrow-down-fill text-primary me-2"></i>Recent Work Submissions
                        </h5>
                        <a asp-controller="Task" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill">View All Tasks</a>
                    </div>
                    <div class="card-body p-0">
                        @if (mentor.RecentTaskSubmissions != null && mentor.RecentTaskSubmissions.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light small text-uppercase">
                                        <tr>
                                            <th class="ps-4">Intern</th>
                                            <th>Task</th>
                                            <th>Status</th>
                                            <th>Solution File</th>
                                            <th class="text-end pe-4">Review</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var task in mentor.RecentTaskSubmissions)
                                        {
                                            <tr>
                                                <td class="ps-4 fw-semibold text-dark">@(task.Intern?.Name ?? "Intern")</td>
                                                <td>
                                                    <div class="small fw-bold">@task.Title</div>
                                                    <small class="text-muted text-truncate d-inline-block" style="max-width: 140px;">@(task.SubmissionNote ?? "No notes")</small>
                                                </td>
                                                <td>
                                                    <span class="badge @(task.Status == "Completed" ? "bg-success" : "bg-info text-dark")">@task.Status</span>
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(task.SubmissionFilePath))
                                                    {
                                                        <a href="@task.SubmissionFilePath" target="_blank" download class="btn btn-xs btn-sm btn-outline-success py-1 px-2 small">
                                                            <i class="bi bi-download me-1"></i> File
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted small">Notes only</span>
                                                    }
                                                </td>
                                                <td class="text-end pe-4">
                                                    <a asp-controller="Task" asp-action="Details" asp-route-id="@task.Id" class="btn btn-sm btn-primary rounded-pill">
                                                        Inspect
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="p-4 text-center text-muted">
                                <i class="bi bi-journal-check fs-2 text-primary d-block mb-2"></i>
                                No task submissions uploaded by your interns yet.
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Assigned Interns List -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-people-fill text-success me-2"></i>My Mentees
                        </h5>
                        <a asp-controller="Task" asp-action="Create" class="btn btn-sm btn-primary rounded-pill">
                            <i class="bi bi-plus me-1"></i> Assign Task
                        </a>
                    </div>
                    <div class="card-body p-0">
                        @if (mentor.MyInterns != null && mentor.MyInterns.Any())
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var intern in mentor.MyInterns)
                                {
                                    <div class="list-group-item p-3 border-0 border-bottom d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-2 fs-4 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                                                <i class="bi bi-person"></i>
                                            </div>
                                            <div>
                                                <h6 class="fw-bold mb-0 text-dark">@intern.Name</h6>
                                                <span class="small text-muted">@intern.Email • @(intern.Department?.Name ?? "General")</span>
                                            </div>
                                        </div>
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            @intern.Status
                                        </span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="p-4 text-center text-muted">
                                <i class="bi bi-person-x fs-2 d-block mb-2"></i>
                                No interns assigned to you currently.
                            </div>
                        }
                    </div>
                </div>
            </div>

        </div>
    }

    @* ==========================================
       4. INTERN DASHBOARD VIEW
       ========================================== *@
    @if (isIntern && Model.InternData != null)
    {
        var intern = Model.InternData;

        <!-- Intern Profile & Attendance Alert -->
        <div class="row g-3 mb-4">
            <div class="col-md-8">
                <div class="card border-0 shadow-sm rounded-4 bg-white p-4 h-100">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-primary text-white rounded-circle p-3 fs-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                            <i class="bi bi-person-badge"></i>
                        </div>
                        <div>
                            <h4 class="fw-bold mb-1">@intern.InternName</h4>
                            <div class="d-flex flex-wrap gap-2 text-muted small">
                                <span><i class="bi bi-building me-1"></i> Department: <strong>@intern.DepartmentName</strong></span>
                                <span>•</span>
                                <span><i class="bi bi-person-workspace me-1"></i> Mentor: <strong>@intern.MentorName</strong></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 h-100 @(intern.HasClockedInToday ? "bg-success bg-opacity-10 text-success" : "bg-warning bg-opacity-10 text-warning-emphasis")">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="small fw-bold text-uppercase mb-1">Today's Attendance</p>
                            @if (intern.HasClockedInToday)
                            {
                                <h5 class="fw-bold mb-0 text-success"><i class="bi bi-check-circle-fill me-1"></i> Present Today</h5>
                                <span class="small text-muted">Attendance recorded for @DateTime.Today.ToString("MMM dd, yyyy")</span>
                            }
                            else
                            {
                                <h5 class="fw-bold mb-1 text-danger"><i class="bi bi-exclamation-circle-fill me-1"></i> Not Marked Yet</h5>
                                <a asp-controller="Attendance" asp-action="Create" class="btn btn-sm btn-primary rounded-pill mt-1">
                                    <i class="bi bi-fingerprint me-1"></i> Clock In Now
                                </a>
                            }
                        </div>
                        <div class="fs-1">
                            <i class="bi @(intern.HasClockedInToday ? "bi-check2-all text-success" : "bi-clock text-warning")"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Intern Stats Breakdown -->
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 bg-white border-start border-primary border-4">
                    <div class="card-body p-3 d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small fw-semibold">Assigned Tasks</span>
                            <h3 class="fw-bold mb-0 text-dark">@intern.AssignedTasksCount</h3>
                        </div>
                        <div class="bg-primary bg-opacity-10 text-primary p-2 rounded-circle fs-4">
                            <i class="bi bi-journal-text"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 bg-white border-start border-warning border-4">
                    <div class="card-body p-3 d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small fw-semibold">Pending / In Progress</span>
                            <h3 class="fw-bold mb-0 text-warning-emphasis">@intern.PendingTasksCount</h3>
                        </div>
                        <div class="bg-warning bg-opacity-10 text-warning p-2 rounded-circle fs-4">
                            <i class="bi bi-hourglass-split"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 bg-white border-start border-success border-4">
                    <div class="card-body p-3 d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small fw-semibold">Completed Tasks</span>
                            <h3 class="fw-bold mb-0 text-success">@intern.CompletedTasksCount</h3>
                        </div>
                        <div class="bg-success bg-opacity-10 text-success p-2 rounded-circle fs-4">
                            <i class="bi bi-check2-circle"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Intern Tasks & Leaves Table -->
        <div class="row g-4">
            <!-- Active Tasks -->
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-list-task text-primary me-2"></i>My Active Tasks
                        </h5>
                        <a asp-controller="Task" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill">View All</a>
                    </div>
                    <div class="card-body p-0">
                        @if (intern.MyPendingTasks != null && intern.MyPendingTasks.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light small text-uppercase">
                                        <tr>
                                            <th class="ps-4">Task Title</th>
                                            <th>Due Date</th>
                                            <th>Status</th>
                                            <th class="text-end pe-4">Update Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var task in intern.MyPendingTasks)
                                        {
                                            <tr>
                                                <td class="ps-4 fw-semibold text-dark">@task.Title</td>
                                                <td class="small text-muted">@task.DueDate.ToString("MMM dd, yyyy")</td>
                                                <td>
                                                    @if (task.Status == "In Progress")
                                                    {
                                                        <span class="badge bg-info text-dark">In Progress</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning text-dark">Pending</span>
                                                    }
                                                </td>
                                                <td class="text-end pe-4">
                                                    <div class="dropdown d-inline">
                                                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle rounded-pill" type="button" data-bs-toggle="dropdown">
                                                            Change
                                                        </button>
                                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                                            <li>
                                                                <form asp-controller="Task" asp-action="UpdateStatus" method="post">
                                                                    @Html.AntiForgeryToken()
                                                                    <input type="hidden" name="id" value="@task.Id" />
                                                                    <input type="hidden" name="status" value="In Progress" />
                                                                    <button type="submit" class="dropdown-item small"><i class="bi bi-arrow-repeat text-info me-2"></i>In Progress</button>
                                                                </form>
                                                            </li>
                                                            <li>
                                                                <form asp-controller="Task" asp-action="UpdateStatus" method="post">
                                                                    @Html.AntiForgeryToken()
                                                                    <input type="hidden" name="id" value="@task.Id" />
                                                                    <input type="hidden" name="status" value="Completed" />
                                                                    <button type="submit" class="dropdown-item small"><i class="bi bi-check2-circle text-success me-2"></i>Completed</button>
                                                                </form>
                                                            </li>
                                                        </ul>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="p-4 text-center text-muted">
                                <i class="bi bi-emoji-smile fs-2 text-primary d-block mb-2"></i>
                                You're all caught up on your tasks!
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Recent Leaves & Progress Reports -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-calendar2-check text-success me-2"></i>My Leave Requests
                        </h5>
                        <a asp-controller="Leave" asp-action="Create" class="btn btn-sm btn-primary rounded-pill">
                            <i class="bi bi-plus me-1"></i> Request Leave
                        </a>
                    </div>
                    <div class="card-body p-0">
                        @if (intern.MyLeaveRequests != null && intern.MyLeaveRequests.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light small text-uppercase">
                                        <tr>
                                            <th class="ps-4">Dates</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var l in intern.MyLeaveRequests)
                                        {
                                            <tr>
                                                <td class="ps-4 small">@l.StartDate.ToString("MMM dd") - @l.EndDate.ToString("MMM dd")</td>
                                                <td>
                                                    @if (l.Status == "Approved")
                                                    {
                                                        <span class="badge bg-success">Approved</span>
                                                    }
                                                    else if (l.Status == "Rejected")
                                                    {
                                                        <span class="badge bg-danger">Rejected</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning text-dark">Pending</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="p-3 text-center text-muted small">No leave requests submitted yet.</div>
                        }
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-journal-text text-info me-2"></i>My Progress Reports
                        </h5>
                        <a asp-controller="ProgressReport" asp-action="Create" class="btn btn-sm btn-outline-primary rounded-pill">
                            <i class="bi bi-plus me-1"></i> New Report
                        </a>
                    </div>
                    <div class="card-body p-0">
                        @if (intern.MyProgressReports != null && intern.MyProgressReports.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light small text-uppercase">
                                        <tr>
                                            <th class="ps-4">Date</th>
                                            <th>Status</th>
                                            <th class="text-end pe-4">Notes</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in intern.MyProgressReports)
                                        {
                                            <tr>
                                                <td class="ps-4 small text-dark fw-semibold">@r.Date.ToString("MMM dd, yyyy")</td>
                                                <td><span class="badge bg-info text-dark">@r.Status</span></td>
                                                <td class="text-end pe-4 small text-truncate" style="max-width: 120px;" title="@r.Notes">@r.Notes</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="p-3 text-center text-muted small">No progress reports submitted yet.</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

</div>
@model IMS.Web.Models.ViewModels.HRDashboardViewModel

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <h2 class="fw-bold mb-0">HR & Management Portal 📊</h2>
    <span class="badge bg-primary fs-6">HR / Mentor</span>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card bg-success text-white shadow-sm border-0 h-100">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 text-white-50">Active Interns</h6>
                <h2 class="card-title fw-bold mb-0">@Model.ActiveInternsCount</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-warning text-dark shadow-sm border-0 h-100">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 text-dark-50">Pending Leaves</h6>
                <h2 class="card-title fw-bold mb-0">@Model.PendingLeavesCount</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-info text-white shadow-sm border-0 h-100">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 text-white-50">Present Today</h6>
                <h2 class="card-title fw-bold mb-0">@Model.TodayPresentCount</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-secondary text-white shadow-sm border-0 h-100">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 text-white-50">Pending Tasks</h6>
                <h2 class="card-title fw-bold mb-0">@Model.PendingTasksCount</h2>
            </div>
        </div>
    </div>
</div>